# ==============================================================
# Template for .env — copy this file to ".env" and fill in values.
# Safe to commit (contains no real secrets).
# ==============================================================

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-random-50-char-string

# True for local development, False in production
DEBUG=True

# Comma-separated hostnames, e.g. localhost,127.0.0.1,api.bookmyvenue.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Empty = local sqlite. In production use the Supabase Postgres string:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# True only in development; set False in production and list origins below
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated frontend URLs, e.g. https://bookmyvenue.com
CORS_ALLOWED_ORIGINS=

# --- OTP delivery by SMS -------------------------------------------------
# Fast2SMS is the primary provider; 2Factor is the fallback when its key is
# absent. The OTP is generated and hashed on OUR server — the provider only
# delivers it.
FAST2SMS_API_KEY=

# Route: 'dlt' (TRAI-compliant, ~25 paise, REQUIRES the three values below),
# 'q' (quick — free-form text, higher rate), or 'otp' (needs website
# verification on the Fast2SMS dashboard).
FAST2SMS_ROUTE=q
# Your approved 6-character DLT header, e.g. TBMV
FAST2SMS_SENDER_ID=
# Numeric Message ID of the approved template (Fast2SMS -> DLT Manager).
# On the DLT route the carrier already holds the wording: we send this id
# plus the variable, never message text.
FAST2SMS_DLT_TEMPLATE_ID=

# 2Factor.in fallback (get it from the 2factor.in dashboard)
TWOFACTOR_API_KEY=
# Template NAME registered with 2Factor; forces the SMS route over voice.
TWOFACTOR_SMS_TEMPLATE=

# Supabase Storage (photo uploads) — Settings -> API keys in the dashboard
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=venue-photos

# --- Transactional email (Resend) ----------------------------------------
# Carries the OTP alongside SMS, and the booking confirmations.
RESEND_API_KEY=
# Must be a domain verified in Resend. onboarding@resend.dev works for
# testing but only delivers to your own account address.
RESEND_FROM=onboarding@resend.dev

# --- Promotional email campaigns (Super Admin -> Email Campaigns) -----------
# Uses RESEND_API_KEY above; OTP and booking mail are not affected.
# Master switch, OFF by default so nothing is ever sent by accident:
#   off      nothing can be sent (drafts and previews still work)
#   dry-run  the whole send runs but Resend is never called (rehearsal)
#   resend   real email — production only
CAMPAIGN_DELIVERY=off
# Sender for promotions. Recommended: a separate verified subdomain such as
# offers@news.thebookmyvenues.in, so spam reports on promotions can never hurt
# OTP / booking delivery. Blank = RESEND_FROM.
CAMPAIGN_FROM=
CAMPAIGN_REPLY_TO=
# Optional business postal address printed in the campaign footer.
CAMPAIGN_POSTAL_ADDRESS=
# Public https URL of THIS backend, used in unsubscribe links, e.g.
# https://bookmyvenues-backend.onrender.com  (blank = taken from the request)
PUBLIC_API_BASE_URL=
# Signing secret of a Resend webhook pointed at
#   <backend>/api/email/webhooks/resend
# (events: delivered, bounced, complained, opened, clicked, failed).
# Blank = reports show sent/failed only.
RESEND_WEBHOOK_SECRET=
# Send campaigns on a background thread of the web process (True), or only
# via `python manage.py send_email_campaigns` (False, e.g. a cron job).
CAMPAIGN_INLINE_WORKER=True

# --- Booking notifications ------------------------------------------------
# Sent to the customer AND the vendor when a payment confirms.
# SMS stays False until booking templates are DLT-approved: the DLT route
# REJECTS any text that is not a registered template, so unapproved booking
# SMS fails outright rather than merely costing more.
NOTIFY_EMAIL_ENABLED=True
NOTIFY_SMS_ENABLED=False

# --- Branding (emails) ----------------------------------------------------
# Optional https URL of a logo image (~240px wide). Unset falls back to a
# typographic wordmark, which always renders even when the mail client
# blocks images.
BRAND_LOGO_URL=
BRAND_SITE_URL=https://thebookmyvenues.in

# --- Payments (Razorpay) --------------------------------------------------
# Test keys and live keys are a pure env-var swap — no code change.
# Every customer booking goes through this; without it, none can be created.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay webhook settings; the webhook is the source of truth for
# whether a booking is paid, so this must be set in production.
RAZORPAY_WEBHOOK_SECRET=

# --- Geocoding (customer location picker + vendor wizard) ------------------
# Leave blank to disable server-side geocoding (the site then falls back to
# its built-in India state/district lists, GPS and OpenStreetMap).
# Production (Render): GEOCODER_PROVIDER=google, GEOCODER_COUNTRY=IN and a
# SERVER key with "Geocoding API" + "Places API (New)" enabled. Restrict that
# key by API (and optionally by Render's outbound IPs) — NOT by HTTP referrer:
# Google rejects referrer-restricted keys on server calls (REQUEST_DENIED).
# Google API keys must remain server-side and must never use a VITE_ prefix.
GEOCODER_PROVIDER=
GEOCODER_COUNTRY=
GOOGLE_GEOCODING_API_KEY=
# Optional: a separate server key for Places API (New) autocomplete. When
# blank, GOOGLE_GEOCODING_API_KEY is used for both.
GOOGLE_PLACES_API_KEY=
